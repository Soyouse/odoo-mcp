{
  "name": "odoo-mcp",
  "version": "1.0.0",
  "type": "module",
  "main": "proxy.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "sh test/run-contract.sh",
    "prepare": "husky",
    "mutation": "stryker run",
    "dup": "jscpd .",
    "arch": "depcruise --config .dependency-cruiser.cjs .",
    "coupling": "npm run dup && npm run arch"
  },
  "keywords": ["odoo", "mcp", "claude-code", "guardrails"],
  "author": "Soyouse",
  "license": "MIT",
  "description": "Guarded Odoo MCP for Claude Code — post-write readback, duplicate-send/-invoice guards, silent-email scan, ID-provenance hook.",
  "repository": { "type": "git", "url": "https://github.com/Soyouse/odoo-mcp" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "dependency-cruiser": "^18.0.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "vitest": "^4.1.11"
  }
}
